# ==========================================
# 数据库配置 - PostgreSQL
# ==========================================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_companion
DB_USER=postgres
DB_PASSWORD=postgres

# 连接池配置
DB_POOL_MIN=2
DB_POOL_MAX=20

# ==========================================
# Redis 配置
# ==========================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ==========================================
# 服务器配置
# ==========================================

API_PORT=3000
API_HOST=0.0.0.0
NODE_ENV=development

# ==========================================
# BullMQ 队列配置
# ==========================================

WORKER_CONCURRENCY=3
WORKER_MAX_RETRIES=3
WORKER_TIMEOUT=120000

# 队列名称
GACHA_QUEUE_NAME=gacha-pull
SCRIPT_QUEUE_NAME=ai-script-generate

# ==========================================
# LLM 配置
# ==========================================

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4
OPENAI_BASE_URL=https://api.openai.com/v1

LLM_TIMEOUT=60000

# ==========================================
# WebSocket 配置
# ==========================================

WS_PORT=3001
WS_HOST=0.0.0.0

# ==========================================
# 日志配置
# ==========================================

LOG_LEVEL=info
LOG_FILE=logs/app.log
